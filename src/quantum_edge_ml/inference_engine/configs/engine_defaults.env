# LLM engine defaults for Gemma 3 4B text-only
MODEL_NAME=gemma3-4b-text
MODEL_DIR=/path/to/gemma3-4b-text
OUT_DIR=llm_engine/artifacts
CALIB_JSONL=llm_engine/configs/calib_prompts.jsonl
CALIB_SIZE=64
CALIB_SEQ_LEN=256
MAX_INPUT_LEN=2048
MAX_OUTPUT_LEN=512
MAX_BATCH_SIZE=1
TOTAL_TOKENS=4096
CKPT_DIR=${OUT_DIR}/ckpt_gemma3_4b_awq_int4
ENGINE_DIR=${OUT_DIR}/engine_gemma3_4b_awq_int4
HOST=127.0.0.1
PORT=8000
USE_DOCKER=1
# NGC image tag for Triton + TensorRT-LLM python container
# Requires NVIDIA driver >= 580.95.05 for 25.12 (see Triton compatibility matrix)
# Fallbacks: 25.01-trtllm-python-py3 (~570.86.10), 24.12-trtllm-python-py3 (~560.35.05)
NGC_IMAGE=nvcr.io/nvidia/tritonserver:25.12-trtllm-python-py3
