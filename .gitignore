# Virtual envs
**/venv/
**/.venv/
**/env/

# Python caches
__pycache__/
*.pyc

# Logs/runtime/data outputs
/logs/
/runtime/
/data/
**/logs/
**/runtime/
**/data/
*.log
/artifacts/
storage/models/
**/storage/models/

# Secrets and encrypted files
**/secrets.env
**/.env
**/*.env
**/*.enc
**/*.key
**/*.pem
**/*.pfx
**/*.p12
**/backup_secrets/
**/secrets/
**/config/secrets*

# Allow tracked secrets templates
!config/secrets.local.env.example

# IDE
.vscode/
.idea/

# Build/test caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
dist/
build/
*.egg-info/

# Allow repo-scoped VS Code settings
!/.vscode/
!/.vscode/*.json
